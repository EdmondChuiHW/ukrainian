@prefix lexvo:  <http://lexvo.org/id/iso639-3/> .
@prefix eng:    <http://kaiko.getalp.org/dbnary/eng/> .

eng:__en_gloss_12345_mati__Noun__1
        rdf:type     dbnary:Gloss;
        rdf:value    "female parent"@en;
        dbnary:rank  "1"^^xs:int .

eng:__tr_ukr_1_mati__Noun__1
        rdf:type                dbnary:Translation;
