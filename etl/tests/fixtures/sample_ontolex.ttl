        dbnary:targetLanguage   lexvo:ukr;
        dbnary:usage            "f";
        dbnary:writtenForm      "ма́ти"@uk .

eng:__en_gloss_67890_have__Verb__1
        rdf:type     dbnary:Gloss;
        rdf:value    "to possess"@en;
